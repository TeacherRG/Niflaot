ении","רְשׁוּת"],"נאסר":["стал запретным"],"פנים":["способы, случаи (досл. «лица»)"],"יש":["есть"],"בהם":["в них"],"נסוך":["возлияние"],"כלל":["совсем (אֵין… כְּלָל — вовсе нет)"],"ואסרו":["и запретили","אָסַר"],"אותם":["их"],"חכמים":["мудрецы","חָכָם"],"להרחיק":["чтобы отдалить","הִרְחִיק"],"מן":["от"],"הנסוך":["возлияния","נִסּוּךְ"],"ואלו":["и вот они"],"ימזג":["смешает, нальёт (воду в вино)","מָזַג"],"המים":["воду","מַיִם"],"לתוך":["внутрь, в"],"שביד":["которое в руке, у"],"יבוא":["придёт, станет","בָּא"],"לצק":["наливать","יָצַק"],"יוליך":["понесёт","הוֹלִיךְ"],"ענבים":["виноград","עֵנָב"],"לגת":["в давильню","גַּת"],"לגע":["касаться","נָגַע"],"יסיע":["поможет","סִיֵּעַ"],"בשעה":["в то время, когда","שָׁעָה"],"שמריק":["когда переливает","הֵרִיק"],"מכלי":["из сосуда","כְּלִי"],"לכלי":["в сосуд","כְּלִי"],"יניח":["поставит, оставит","הִנִּיחַ"],"הכלי":["сосуд","כְּלִי"],"ונמצא":["и выходит, что","נִמְצָא"],"בא":["приходит, получается"],"מכחו":["от его силы (действия)","כֹּחַ"],"סיע":["помог"],"מזג":["смешал, налил"],"הביא":["принёс"],"שיריח":["чтобы нюхать","הֵרִיחַ"],"בחבית":["в бочке","חָבִית"],"להריח":["нюхать","הֵרִיחַ"],"הריח":["запах","רֵיחַ"],"כלום":["что-либо (אֵינוֹ כְּלוּם — ничто)"],"לפי":["потому что; по"],"ממש":["вещество, суть"],"כבר":["уже"],"בארנו":["мы объяснили","בֵּאֵר"],"דבר":["вещь, дело"],"עבר":["нарушил; прошёл"],"ומכרו":["и продал его","מָכַר"],"דמיו":["его цена, деньги за него","דָּמִים"],"מתרין":["разрешены","מֻתָּר"],"חוץ":["кроме (חוּץ מִ…)"],"מעכו״ם":["от идолопоклонства (здесь — идола)"],"ומשמשיה":["и её (принадлежности) служения","מְשַׁמֵּשׁ"],"ותקרבת":["и приношение","תִּקְרֹבֶת"],"שלה":["ей, её"],"ויין":["и вино","יַיִן"],"שנתנסך":["которое было возлито","נִתְנַסֵּךְ"],"לה":["ей"],"והחמירו":["и были строги","הֶחְמִיר"],"בסתם":["в «просто» (סְתַם יֵינָם — их вино вообще, без известного возлияния)","סְתָם"],"יינם":["их вино","יַיִן"],"אסורין":["запрещены","אָסוּר"],"כדמי":["как деньги за","דָּמִים"],"לעכו״ם":["идолопоклоннику","עַכּ